# Kara Tahta production environment template for Railway.
#
# This file is safe to commit because secret values are intentionally empty.
# Copy the names/settings into Railway > karatahta-backend > Variables and
# fill secrets there. Never rename this file to .env and commit real values.

# Server and frontend
PORT=8080
CORS_ORIGIN=https://frontend.example.com,https://karatahta.ethosoft.org,http://localhost:3001,http://127.0.0.1:3001
AUTH_REQUIRED=true
AUTH_PROFILE_CACHE_TTL_MS=300000
AUTH_REDIRECT_URL=https://karatahta.ethosoft.org/
# Set true only after the Google provider and redirect URLs are configured in Supabase.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# DeepSeek LLM
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
# Set to a "gemini-*" model (e.g. gemini-2.5-pro) to route Manim code
# generation to Gemini's OpenAI-compatible endpoint via GEMINI_API_KEY,
# while keeping DeepSeek for lesson planning.
DEEPSEEK_CODE_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_PIPELINE_THINKING=false
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
GEMINI_API_KEY=
KARA_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=45000
LESSON_PREPROCESSOR_TIMEOUT_MS=5000
KARA_LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio-09-2025
KARA_LIVE_ENABLED=false

# TTS
TTS_PROVIDER=edge
EDGE_TTS_COMMAND=edge-tts
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+0%

# Optional Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=tr-TR-Wavenet-E
GOOGLE_TTS_SPEAKING_RATE=0.96

# Manim, video and progressive playback
MANIM_QUALITY=-qm
MANIM_FONT=DejaVu Serif
MANIM_ENABLE_MATHTEX=auto
STREAMING_PLAN_FIRST_SEGMENT=true
PROGRESSIVE_MANIM_PARTIALS=true
PROGRESSIVE_BUFFER_SECONDS=18
PROGRESSIVE_ARTIFACT_TTL_MS=1800000
SPEECH_VOLUME=1.25
BACKGROUND_MUSIC_VOLUME=0.1
BACKGROUND_MUSIC_FADE_SECONDS=1
TARGET_VIDEO_MINUTES=10
TARGET_SEGMENT_COUNT=8

# Pipeline concurrency. Keep one Railway replica with the current in-memory job design.
SPEECH_CONCURRENCY=3
TTS_CONCURRENCY=4
CODE_CONCURRENCY=2
RENDER_CONCURRENCY=1
EDGE_TTS_TIMEOUT_MS=120000
COMPLETED_JOB_TTL_MS=7200000
RENDER_QUEUE_ENABLED=false
REDIS_URL=
RENDER_WORKER_SHADOW_MODE=true
LOCAL_MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret

# Supabase: Auth and Postgres only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Railway private Bucket: videos, audio and attachments
MEDIA_STORAGE_PROVIDER=railway
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
