# Server
PORT=8080
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
AUTH_REQUIRED=false
AUTH_PROFILE_CACHE_TTL_MS=300000
# Supabase e-posta onayi ve sifre yenileme donus adresi
AUTH_REDIRECT_URL=http://localhost:3001/
# Supabase Google provider ayarlandıktan sonra true yapın
GOOGLE_OAUTH_ENABLED=false

# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_PLAN_MODEL=gemini-3-flash-preview
GEMINI_CODE_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Optional Groq provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PLAN_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=qwen/qwen3-32b
GROQ_REASONING_EFFORT=medium
GROQ_QWEN_REASONING_EFFORT=none

# TTS
TTS_PROVIDER=edge
EDGE_TTS_COMMAND=edge-tts
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+0%

# Optional Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=tr-TR-Wavenet-E
GOOGLE_TTS_SPEAKING_RATE=0.96

# Manim and video
MANIM_QUALITY=-qm
# Canlı segmentler için hızlı önizleme kalitesi ve hedef parça süresi
STREAM_MANIM_QUALITY=-qm
STREAM_SEGMENT_SECONDS=20
# Gemini NDJSON komutlarini tarayici tuvalinde aninda oynatir
LIVE_BOARD_ENABLED=true
LIVE_BOARD_MODEL=gemini-3.5-flash-lite
# Persistent Manim worker canli MP4 yayini
LIVE_MANIM_ENABLED=true
LIVE_MANIM_WORKERS=1
LIVE_MANIM_WIDTH=1280
LIVE_MANIM_HEIGHT=720
LIVE_MANIM_FPS=20
LIVE_MANIM_CRF=23
LIVE_MANIM_PRESET=fast
LIVE_MANIM_FRAGMENT_SECONDS=5
MANIM_FONT=Georgia
MANIM_ENABLE_MATHTEX=auto
SPEECH_VOLUME=1.25
BACKGROUND_MUSIC_VOLUME=0.1
BACKGROUND_MUSIC_FADE_SECONDS=1
TARGET_VIDEO_MINUTES=10
TARGET_SEGMENT_COUNT=8

# Pipeline concurrency
SPEECH_CONCURRENCY=3
TTS_CONCURRENCY=4
CODE_CONCURRENCY=2
RENDER_CONCURRENCY=1
PLAN_DETAIL_CONCURRENCY=2

# Optional Supabase
SUPABASE_URL=
# Current Supabase keys (recommended)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases (only needed when the project has no new keys)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
# Required only when AUTH_REQUIRED=false
DEV_USER_ID=

# Binary media storage (Railway Bucket in production)
MEDIA_STORAGE_PROVIDER=supabase
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
