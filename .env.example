# Server
PORT=8080
CORS_ORIGIN=https://frontend.example.com,http://localhost:3001,http://127.0.0.1:3001
AUTH_REQUIRED=false
AUTH_PROFILE_CACHE_TTL_MS=300000
# Supabase e-posta onayi ve sifre yenileme donus adresi
AUTH_REDIRECT_URL=http://localhost:3001/
# Supabase Google provider ayarlandıktan sonra true yapın
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# DeepSeek LLM
LLM_PROVIDER=deepseek
# DEEPSEEK_API is also accepted for local compatibility.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
# Set to a "gemini-*" model (e.g. gemini-2.5-pro) to route Manim code
# generation to Gemini's OpenAI-compatible endpoint via GEMINI_API_KEY,
# while keeping DeepSeek for lesson planning.
DEEPSEEK_CODE_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_PIPELINE_THINKING=false
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
GEMINI_API_KEY=
KARA_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=45000
LESSON_PREPROCESSOR_TIMEOUT_MS=5000
KARA_LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio-09-2025
KARA_LIVE_ENABLED=false

# TTS
TTS_PROVIDER=edge
EDGE_TTS_COMMAND=edge-tts
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_TIMEOUT_MS=120000

# Optional Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=tr-TR-Wavenet-E
GOOGLE_TTS_SPEAKING_RATE=0.96

# Manim and video
MANIM_QUALITY=-qm
MANIM_FONT=DejaVu Serif
MANIM_ENABLE_MATHTEX=auto
# Gercek Manim partial_movie_files -> authenticated fMP4 manifest.
# Kapaliyken mevcut traditional final-video pipeline aynen calisir.
PROGRESSIVE_MANIM_PARTIALS=false
PROGRESSIVE_BUFFER_SECONDS=18
PROGRESSIVE_ARTIFACT_TTL_MS=1800000
STREAMING_PLAN_FIRST_SEGMENT=false
SPEECH_VOLUME=1.25
BACKGROUND_MUSIC_VOLUME=0.1
BACKGROUND_MUSIC_FADE_SECONDS=1
TARGET_VIDEO_MINUTES=10
TARGET_SEGMENT_COUNT=8

# Pipeline concurrency
SPEECH_CONCURRENCY=3
TTS_CONCURRENCY=4
CODE_CONCURRENCY=2
RENDER_CONCURRENCY=1
COMPLETED_JOB_TTL_MS=7200000
# Distributed render-worker migration. Keep disabled until Redis and at least
# one private Railway render-worker service are configured.
RENDER_QUEUE_ENABLED=false
REDIS_URL=
RENDER_WORKER_SHADOW_MODE=true
# Local /renders fallback URLs are HMAC signed. Use a stable random value in production.
LOCAL_MEDIA_SIGNING_SECRET=

# Optional Supabase
SUPABASE_URL=
# Current Supabase keys (recommended)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases (only needed when the project has no new keys)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
# Queue jobs use a separate signed URL so the social publisher has time to
# claim and upload it. Maximum supported value is 86400 seconds (24 hours).
SOCIAL_PUBLISH_VIDEO_URL_TTL_SECONDS=86400
SOCIAL_PUBLISH_IMAGE_URL_TTL_SECONDS=86400
# Required only when AUTH_REQUIRED=false
DEV_USER_ID=

# Binary media storage (local VPS disk, Railway Bucket, or Supabase)
MEDIA_STORAGE_PROVIDER=supabase
MEDIA_LOCAL_DIR=/data/media
MEDIA_PUBLIC_BASE_URL=
MEDIA_SIGNING_SECRET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Instagram Reels publishing -- POST /api/publish-instagram. Never auto-triggered;
# must be called explicitly per lesson video ({ lesson_id, caption }).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
# IGA... Instagram Login tokens use graph.instagram.com (the default in this app).
# Do not substitute a Facebook Page token unless the publisher is changed to the
# legacy Facebook Login flow.

# YouTube publishing -- POST /api/publish-youtube. Never auto-triggered;
# must be called explicitly per lesson video ({ lesson_id, title, description }).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token

# TikTok publishing -- POST /api/publish-tiktok. Never auto-triggered;
# must be called explicitly per lesson video ({ lesson_id, title }).
# TIKTOK_CLIENT_KEY/SECRET come from the TikTok Developer Portal app.
# TIKTOK_REFRESH_TOKEN is bootstrapped once via the browser flow at
# GET /api/oauth/tiktok/start?setup_token=... (requires TIKTOK_OAUTH_SETUP_TOKEN
# below); the callback prints the refresh_token to paste in here.
# Until the app passes TikTok's app review, posts can only be SELF_ONLY (private).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OAUTH_SETUP_TOKEN=
# Optional -- defaults to PUBLIC_BASE_URL (or the request host) + /api/oauth/tiktok/callback.
# Set explicitly if it must match a redirect URI registered exactly in the TikTok app.
TIKTOK_REDIRECT_URI=

# Generic social-publisher worker. It consumes publish_jobs records containing
# an HTTPS videoUrl; set this to restrict which storage/CDN hosts it may fetch.
ALLOWED_VIDEO_HOSTS=
# Optional multi-tenant credential resolver. OAuth tokens stay out of jobs.
CREDENTIALS_PROVIDER_URL=
CREDENTIALS_PROVIDER_TOKEN=

# Social-media publishing is a separate server-side API gate. After a completed
# create-video/generate-lesson job returns result.videoId, call POST
# /api/social-publish with { "video_id": "..." }. The API queues the job and
# the separate Railway social-publisher worker reads the final Bucket video and
# publishes it to both Instagram and YouTube. The browser never uploads media.

# Only needed when MEDIA_STORAGE_PROVIDER=local (Supabase/Railway signed URLs are
# already absolute) -- lets the publish endpoints turn a relative /renders/... URL
# into an absolute one Instagram/YouTube can fetch.
PUBLIC_BASE_URL=

# Content scheduler -- runs inside the social-publisher worker
# (services/scheduler.js), picks ideas in order from a content_pool.txt
# (one idea per line, managed via GET/PUT /api/scheduler/content-pool,
# stored in the Railway Bucket at bucket "system"), and calls this API's own
# /api/cards/generate + /publish-instagram or /api/generate-lesson +
# /api/social-publish endpoints to generate and publish content. Off by
# default per job_type; toggle with POST /api/scheduler/start|stop
# { job_type: "cards_carousel" | "lesson_video", interval_minutes }.
# BACKEND_INTERNAL_URL and SCHEDULER_INTERNAL_TOKEN must be set on BOTH the
# main API and the social-publisher service for this to work.
BACKEND_INTERNAL_URL=
SCHEDULER_INTERNAL_TOKEN=
SCHEDULER_USER_ID=
SCHEDULER_TICK_MS=60000
SCHEDULER_JOB_TIMEOUT_MS=900000
# Only used by job_type "combo": gap between publishing the lesson video and
# publishing the same idea's card carousel.
SCHEDULER_COMBO_GAP_MS=600000
# Scheduled lesson_video/combo runs use a short lesson on purpose -- the
# default topic-mode length (8 segments/10 min) overloads a single trial-plan
# render-worker replica badly enough to fail (verified live).
SCHEDULER_VIDEO_SEGMENT_COUNT=3
SCHEDULER_VIDEO_MINUTES=3.5
