# Server
PORT=8080
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
AUTH_REQUIRED=false
AUTH_PROFILE_CACHE_TTL_MS=300000
# Supabase e-posta onayi ve sifre yenileme donus adresi
AUTH_REDIRECT_URL=http://localhost:3001/
# Supabase Google provider ayarlandıktan sonra true yapın
GOOGLE_OAUTH_ENABLED=false

# DeepSeek LLM
LLM_PROVIDER=deepseek
# DEEPSEEK_API is also accepted for local compatibility.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_CODE_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_PIPELINE_THINKING=false
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
GEMINI_API_KEY=
KARA_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=45000
KARA_LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio-09-2025

# TTS
TTS_PROVIDER=edge
EDGE_TTS_COMMAND=edge-tts
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_TIMEOUT_MS=120000

# Optional Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=tr-TR-Wavenet-E
GOOGLE_TTS_SPEAKING_RATE=0.96

# Manim and video
MANIM_QUALITY=-qm
MANIM_FONT=Georgia
MANIM_ENABLE_MATHTEX=auto
# Gercek Manim partial_movie_files -> authenticated fMP4 manifest.
# Kapaliyken mevcut traditional final-video pipeline aynen calisir.
PROGRESSIVE_MANIM_PARTIALS=false
PROGRESSIVE_BUFFER_SECONDS=18
PROGRESSIVE_ARTIFACT_TTL_MS=1800000
STREAMING_PLAN_FIRST_SEGMENT=false
SPEECH_VOLUME=1.25
BACKGROUND_MUSIC_VOLUME=0.1
BACKGROUND_MUSIC_FADE_SECONDS=1
TARGET_VIDEO_MINUTES=10
TARGET_SEGMENT_COUNT=8

# Pipeline concurrency
SPEECH_CONCURRENCY=3
TTS_CONCURRENCY=4
CODE_CONCURRENCY=2
RENDER_CONCURRENCY=2
COMPLETED_JOB_TTL_MS=7200000
# Local /renders fallback URLs are HMAC signed. Use a stable random value in production.
LOCAL_MEDIA_SIGNING_SECRET=

# Optional Supabase
SUPABASE_URL=
# Current Supabase keys (recommended)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases (only needed when the project has no new keys)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_STORAGE_PUBLIC=false
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
# Required only when AUTH_REQUIRED=false
DEV_USER_ID=

# Binary media storage (local VPS disk, Railway Bucket, or Supabase)
MEDIA_STORAGE_PROVIDER=supabase
MEDIA_LOCAL_DIR=/data/media
MEDIA_PUBLIC_BASE_URL=
MEDIA_SIGNING_SECRET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_URL_STYLE=virtual-host
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
