# Backend API base URL baked into the production build. Leave empty to use
# same-origin paths (/api, /renders): in development the Vite proxy forwards
# them to KARA_BACKEND_URL; in production put a reverse proxy in front.
VITE_API_BASE_URL=

# Dev server only: where the Vite proxy sends /api and /renders.
KARA_BACKEND_URL=http://localhost:8080

# Optional second backend for the developer portal's VPS / hybrid modes.
# Empty means every mode uses VITE_API_BASE_URL.
VITE_VPS_API_BASE_URL=

# Comma-separated emails that can see the developer portal (backend mode
# selector, health checks) and the per-lesson developer console (job
# metrics, raw log output). Everyone else never sees them. Leave empty to
# hide from everyone.
VITE_ADMIN_EMAILS=
